-        Sync1_Isr();
-
-        SyncAcknowledgePending = TRUE;
-    }
-    /*ECATCHANGE_END(V5.13) ECAT1*/
-    
-
-    if(bEscIntEnabled)
-    {
-        if ( ALEvent & PROCESS_OUTPUT_EVENT )
-        {
-            if(bDcRunning && bDcSyncActive)
-            {
-                /* Reset SM/Sync0 counter. Will be incremented on every Sync0 event*/

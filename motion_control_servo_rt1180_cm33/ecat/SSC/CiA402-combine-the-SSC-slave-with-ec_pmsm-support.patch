-void Sync0_Isr(void)
-{
-     Sync0WdCounter = 0;
-
-    if(bDcSyncActive)
-    {
-/*ECATCHANGE_START(V5.13) ECAT 6*/
-        BOOL bCallInputMapping = FALSE;

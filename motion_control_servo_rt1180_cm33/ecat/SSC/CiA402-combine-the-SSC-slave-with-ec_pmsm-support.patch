+/////////////////////////////////////////////////////////////////////////////////////////
+/**
+\brief    This function is called when a X to Init transition is completed
+
+*////////////////////////////////////////////////////////////////////////////////////////
+
+void BackToInitTransition(void)
+{
+    /* Reset indication that the user has written a sync mode*/
+    bSyncSetByUser = FALSE;
+}

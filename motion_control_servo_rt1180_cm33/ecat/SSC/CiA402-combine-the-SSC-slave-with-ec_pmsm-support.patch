-			bSdoSegFollows = TRUE;
-		}
-
-		/* copy the object data in the SDO Upload segment response */
-		MBXMEMCPY(pSdoSegRes->SdoHeader.Data, &(((UINT8*)pSdoSegData)[nSdoSegBytesToHandle]), size);

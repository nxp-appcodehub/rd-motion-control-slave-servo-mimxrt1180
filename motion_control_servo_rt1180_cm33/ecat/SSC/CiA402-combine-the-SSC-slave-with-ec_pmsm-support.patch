-			/* size of the mailbox response data */
-			pSdoInfoInd->MbxHeader.Length = size;
-
-			if (abort == 0)
-			{
-				pSdoInfoInd->SdoHeader.InfoHead &= ~INFOHEAD_OPCODE_MASK;

+							pData = (UINT16 MBXMEM *) ((TINITSDOUPLOADEXPRESMBX MBXMEM *) pSdoInd)->Data;
+													/* initialize the 4 data bytes of the SDO upload response because the requested object data
+														could be less than 4 */

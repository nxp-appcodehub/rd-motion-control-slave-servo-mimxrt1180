-            if(alStatusCode != 0)
-            {
-                /*ECATCHANGE_START(V5.13) ESM1*/
-                u8LocalErrorState = (alStatus & STATE_MASK);
-                /*ECATCHANGE_END(V5.13) ESM1*/
-                u16LocalErrorCode = alStatusCode;

-
-            if (LatchInputSync0Value == LatchInputSync0Counter)
-            {
-                bCallInputMapping = TRUE;
-            }
-        }
-/*ECATCHANGE_END(V5.13) ECAT 6*/
-
-        if(u16SmSync0Value > 0)
